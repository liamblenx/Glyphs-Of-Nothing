<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.artemis.glyphtoy">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight">

        <!-- Activity to redirect to the system Glyph Toys manager -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Artemis trajectory Glyph Toy -->
        <service
            android:name=".ArtemisGlyphToyService"
            android:exported="true">

            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <!-- Required: toy name shown in the system Glyph Toys manager -->
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />

            <!-- Required: 1:1 preview image (ideally 200x200 px) -->
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/preview_artemis" />

            <!-- Optional: short description -->
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />

            <!-- Enable long-press to pause/resume -->
            <meta-data
                android:name="com.nothing.glyph.toy.longpress"
                android:value="1" />

            <!-- Enable Always-On Display support -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

    </application>
</manifest>
